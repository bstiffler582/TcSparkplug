<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{9de1eff4-ff5a-4af7-8ca5-9fc8464e4f9b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	fbMqttClient	: FB_IotMqttClient := (sHostName:='127.0.0.1', nHostPort:= 1883);
	fbSpkSession	: FB_SparkplugSession;
	nBdSeq			: ULINT;
	bSpkEnable		: BOOL := TRUE;

	// Motor1 device — generic device FB, metrics registered once at startup
	fbDevice1		: FB_SparkplugDevice;
	bDeviceInit		: BOOL;

	// Metric values — adjust in watch window during testing
	nMotorSpeed		: UDINT := 1450;
	bMotorRunning	: BOOL  := TRUE;
	fMotorTemp		: REAL  := 23.5;

	// Periodic DDATA — fires at regular interval
	tDataInterval	: TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//PRG_ProtoTests();
//PRG_SparkplugPayloadTests();

// Session must be called first — sets GroupId/NodeId before AddDevice reads them.
fbSpkSession(
	sGroupId    := 'BeckhoffUSA',
	sNodeId     := 'PLC1',
	fbMqttClient:= fbMqttClient,
	bEnable     := bSpkEnable,
	nBdSeq      := nBdSeq);

// One-time initialisation: register metrics and add device to the session.
IF NOT bDeviceInit THEN
	fbDevice1.AddMetric('Speed',       1, nMotorSpeed);
	fbDevice1.AddMetric('Running',     2, bMotorRunning);
	fbDevice1.AddMetric('Temperature', 3, fMotorTemp);
	fbSpkSession.AddDevice('Motor1', fbDevice1);
	bDeviceInit := TRUE;
END_IF

// Cyclic device call — runs change detection and auto-publishes DDATA on any change.
fbDevice1(bAutoPublish := TRUE);

// Periodic refresh — publishes full DDATA every 30s with optional bChangedOnly flag.
tDataInterval(IN := NOT tDataInterval.Q, PT := T#30S);
IF tDataInterval.Q THEN
	fbDevice1.PublishData();
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>