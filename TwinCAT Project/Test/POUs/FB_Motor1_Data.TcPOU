<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Motor1_Data" Id="{cc000002-0000-0000-0000-000000000000}" SpecialFunc="None">
    <Declaration><![CDATA[// Hand-written example of what the protoc code generator would produce
// for a "Motor1" device DDATA message (DATA mode — alias-only, no names).
//
// Aliases match the DBIRTH schema (FB_Motor1_Birth):
//   alias 1 — Speed       (UInt32, rpm)
//   alias 2 — Running     (Boolean)
//   alias 3 — Temperature (Float, °C)
//
// DATA messages omit metric names (sName := '') to save bandwidth. The host
// resolves alias → name from the preceding DBIRTH.
//
// Usage:
//   IF tPublish.Q AND fbSession.bOnline THEN
//     fbMotor1Data.Build(F_GetUnixTimestampMs(), fbSession.GetNextSeq(), nSpeed, bRunning, fTemp);
//     fbSession.Publish(sDataTopic, fbMotor1Data.Buffer, fbMotor1Data.Length);
//   END_IF
FUNCTION_BLOCK FB_Motor1_Data
VAR
	_aBuf		: ARRAY[0..127] OF BYTE;	// smaller — no metric names in DATA mode
	_fbPayload	: FB_SparkplugPayload;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// FB body intentionally empty — all logic is in Build().]]></ST>
    </Implementation>
    <Property Name="Buffer" Id="{cc000002-0000-0000-0000-000000000002}">
      <Declaration><![CDATA[PROPERTY Buffer : POINTER TO BYTE]]></Declaration>
      <Get Name="Get" Id="{cc000002-0000-0000-0000-000000000003}">
        <Declaration><![CDATA[VAR END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Buffer := _fbPayload.Buffer;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Build" Id="{cc000002-0000-0000-0000-000000000001}">
      <Declaration><![CDATA[// Encodes the DDATA payload (alias-only, no metric names).
// nSeq must come from FB_SparkplugSession.GetNextSeq() immediately before publishing.
METHOD Build : BOOL
VAR_INPUT
	nTimestamp		: ULINT;
	nSeq			: ULINT;
	nSpeed			: UDINT;
	bRunning		: BOOL;
	fTemperature	: REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_fbPayload.Init(ADR(_aBuf), SIZEOF(_aBuf));
_fbPayload.WriteHeader(nTimestamp, nSeq);
// DATA mode: sName := '' — alias is written, name is omitted
_fbPayload.WriteUInt32Metric('', 1, E_SparkplugDataType.UInt32,  nSpeed);
_fbPayload.WriteBoolMetric  ('', 2, E_SparkplugDataType.Boolean, bRunning);
_fbPayload.WriteFloatMetric ('', 3, E_SparkplugDataType.Float,   fTemperature);
Build := NOT _fbPayload.HasError;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Length" Id="{cc000002-0000-0000-0000-000000000004}">
      <Declaration><![CDATA[PROPERTY Length : UDINT]]></Declaration>
      <Get Name="Get" Id="{cc000002-0000-0000-0000-000000000005}">
        <Declaration><![CDATA[VAR END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Length := _fbPayload.Length;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>