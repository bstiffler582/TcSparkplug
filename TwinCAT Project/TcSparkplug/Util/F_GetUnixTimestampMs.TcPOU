<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="F_GetUnixTimestampMs" Id="{3f8b9c2d-4a7e-4f1b-8c5d-9e0a1b2c3d4e}" SpecialFunc="None">
    <Declaration><![CDATA[// Returns the current UTC time as milliseconds since the Unix epoch (1970-01-01 00:00:00 UTC).
// Requires: Tc2_Utilities (for F_GetSystemTime).
// F_GetSystemTime returns a ULINT of 100-nanosecond ticks since 1601-01-01 00:00:00 UTC.
FUNCTION F_GetUnixTimestampMs : ULINT
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 116444736000000000 = number of 100ns ticks from 1601-01-01 to 1970-01-01
//   = 134774 days * 86400 s/day * 10,000,000 ticks/s
// Divide by 10,000 to convert remaining 100ns ticks to milliseconds.
F_GetUnixTimestampMs := (F_GetSystemTime() - 116444736000000000) / 10000;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>