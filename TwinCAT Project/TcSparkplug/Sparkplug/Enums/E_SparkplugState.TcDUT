<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_SparkplugState" Id="{cccccccc-dddd-eeee-ffff-000000000001}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'to_string'}
TYPE E_SparkplugState :
(
	Idle         := 0,	// Not started or cleanly stopped
	Connecting   := 1,	// MQTT connect in progress
	Birthing     := 2,	// NBIRTH published; waiting one cycle for device DBIRTHs
	Online       := 3,	// Fully operational
	Reconnecting := 4	// Connection lost; waiting before retry
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
