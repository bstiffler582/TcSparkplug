<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_SparkplugMessageType" Id="{b2c3d4e5-f6a7-8901-bcde-222222222222}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'to_string'}
// Sparkplug B message types.
// Note: STATE topics use a different structure (spBv1.0/STATE/{scada_host_id})
// and are handled separately in the session manager.
TYPE E_SparkplugMessageType :
(
	NBIRTH := 0,
	NDEATH := 1,
	DBIRTH := 2,
	DDEATH := 3,
	NDATA  := 4,
	DDATA  := 5,
	NCMD   := 6,
	DCMD   := 7
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
